# Copy to .env and fill in. Never commit .env.

# Ethereum RPC endpoint (chain id 1).
# For production use a dedicated provider (Alchemy, Infura, QuickNode).
# Public fallback: https://eth.llamarpc.com
RPC_URL=

# Hex private key of the deployer wallet (64 chars, 0x prefix optional).
# Use a DEDICATED deployer wallet, never your main wallet.
PRIVATE_KEY=

# Filled in after running the deploy script
CONTRACT_ADDRESS=

# Loan terms (passed to the contract constructor)
BORROWER=0xBorrowerAddress
LENDER=0xLenderAddress
PRINCIPAL_ETH=100
ANNUAL_RATE_BPS=650
TERM_MONTHS=360
GRACE_DAYS=15

# Monthly payment in ETH (decimal string, e.g. "0.6321").
# Leave empty and the deploy script computes it via the amortization formula.
MONTHLY_PAYMENT_ETH=

# Payment script: amount to send with recordPayment()
AMOUNT_ETH=0.6321
